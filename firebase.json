{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "dist-firebase",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/jam-tic-kapea-1-sin",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/KonBong",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/konbong",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/KonPov",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/konpov",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/KonKandal",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/konkandal",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/privacy",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/announcement",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          }
        ]
      },
      {
        "source": "/admin-manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          }
        ]
      },
      {
        "source": "/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/jam-tic-kapea-1-sin",
        "destination": "/jam-tic-kapea-1-sin.html"
      },
      {
        "source": "/jam-tic-kapea-1-sin/**",
        "destination": "/jam-tic-kapea-1-sin.html"
      },
      {
        "source": "/KonBong",
        "destination": "/KonBong.html"
      },
      {
        "source": "/konbong",
        "destination": "/KonBong.html"
      },
      {
        "source": "/KonBong/**",
        "destination": "/KonBong.html"
      },
      {
        "source": "/konbong/**",
        "destination": "/KonBong.html"
      },
      {
        "source": "/KonPov",
        "destination": "/KonPov.html"
      },
      {
        "source": "/konpov",
        "destination": "/KonPov.html"
      },
      {
        "source": "/KonPov/**",
        "destination": "/KonPov.html"
      },
      {
        "source": "/konpov/**",
        "destination": "/KonPov.html"
      },
      {
        "source": "/KonKandal",
        "destination": "/KonKandal.html"
      },
      {
        "source": "/konkandal",
        "destination": "/KonKandal.html"
      },
      {
        "source": "/KonKandal/**",
        "destination": "/KonKandal.html"
      },
      {
        "source": "/konkandal/**",
        "destination": "/KonKandal.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/privacy/**",
        "destination": "/privacy.html"
      },
      {
        "source": "/announcement",
        "destination": "/announcement.html"
      },
      {
        "source": "/announcement/**",
        "destination": "/announcement.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
