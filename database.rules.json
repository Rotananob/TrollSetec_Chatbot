{
  "rules": {
    "system_control": {
      ".read": true,
      ".write": true
    },
    "visitor_stats": {
      ".read": true,
      ".write": true
    },
    "live_sessions": {
      ".read": true,
      ".write": true,
      "$sessionId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["updatedAt", "createdAt"]
      }
    },
    "chat_sessions": {
      ".read": true,
      ".write": true,
      "$deviceId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
